{
  "expo": {
    "name": "CareNest",
    "slug": "CareNest",
    "version": "1.0.0",
    "scheme": "carenest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "CareNest cần dùng camera để quét mã QR kết nối tài khoản."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CareNest cần dùng micro để bạn đọc thông tin thuốc và nhập nhanh bằng giọng nói."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "d7bf503c-4404-417a-8402-53891ab50d5c"
      }
    }
  }
}
