# Copy file này thành .env rồi điền giá trị thực
# cp .env.example .env

# PostgreSQL (Docker local)
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=carenest

# Spring Boot datasource (khớp với Docker trên)
DATABASE_URL=jdbc:postgresql://localhost:5433/carenest
DATABASE_USERNAME=carenest
DATABASE_PASSWORD=carenest

# JWT (tự generate secret dài >= 32 ký tự — bắt buộc, app sẽ không khởi động nếu thiếu hoặc quá ngắn)
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — danh sách origin được phép, phân cách bằng dấu phẩy (không dùng wildcard ở production)
CORS_ALLOWED_ORIGINS=http://localhost:8082

# Gmail SMTP (gửi mã xác minh qua email)
# Tạo App Password tại https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thật
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_YOUR_GMAIL_ADDRESS
MAIL_PASSWORD=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD

# React Native (Expo) — API base URL
# Lưu ý: Expo chỉ nhận biến có prefix EXPO_PUBLIC_
# Web (Chrome): http://localhost:8082/api
# Android Emulator: http://10.0.2.2:8082/api
# Real device / iOS Simulator: http://<your-ip>:8082/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8082/api

# Gemini AI (server-side only, used by the backend — get a key at https://aistudio.google.com/apikey)
# Never expose this to the client / never prefix with EXPO_PUBLIC_
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# SpeedSMS (gửi mã OTP qua SMS — đăng ký tại https://speedsms.vn, lấy Access Token trong mục API)
# Để trống thì SmsService chỉ log cảnh báo, không gửi SMS thật.
SMS_ACCESS_TOKEN=REPLACE_WITH_YOUR_SPEEDSMS_ACCESS_TOKEN
SMS_SENDER=
SMS_TYPE=2

# Imou Camera Platform Credentials
IMOU_APP_ID=REPLACE_WITH_YOUR_IMOU_APP_ID
IMOU_APP_SECRET=REPLACE_WITH_YOUR_IMOU_APP_PASSWORD