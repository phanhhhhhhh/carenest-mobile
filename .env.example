# Copy file này thành .env rồi điền giá trị thực
# cp .env.example .env

# PostgreSQL (Docker local)
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=carenest

# Spring Boot datasource (khớp với Docker trên)
DATABASE_URL=jdbc:postgresql://localhost:5433/carenest
DATABASE_USERNAME=carenest
DATABASE_PASSWORD=carenest

# JWT (tự generate secret dài >= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gmail SMTP (gửi mã xác minh qua email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Flutter — Gemini AI
GEMINI_API_KEY=your_key_here
